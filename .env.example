# ===============================================================================
# Interior Design Platform — Canonical Environment Variables Template
# Production Topology: Hostinger VPS (Docker Compose + Caddy) + AWS RDS PostgreSQL 16 + Cloudflare R2
# DO NOT COMMIT REAL CREDENTIALS. Copy to .env.production on the Hostinger VPS.
# ===============================================================================

# -------------------------------------------------------------------------------
# 1. REVERSE PROXY & DOMAIN ROUTING (Caddy Reverse Proxy on Hostinger VPS)
# -------------------------------------------------------------------------------
APP_DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------------------------
# 2. FRONTEND (Next.js 16 Standalone Container)
# -------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Unified-origin model: relative /api/v1 avoids CORS preflight requests and enables strict __Host- cookies
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Internal Docker networking for server-side Next.js data fetching:
INTERNAL_API_URL=http://api:8080/api/v1

# -------------------------------------------------------------------------------
# 3. BACKEND CORE (Spring Boot 3.4 / Java 21 Container)
# -------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework

# -------------------------------------------------------------------------------
# 4. DATABASE CREDENTIALS (AWS RDS PostgreSQL 16)
# -------------------------------------------------------------------------------
# AWS RDS Endpoint format: <db-name>.<unique-id>.<aws-region>.rds.amazonaws.com
# Recommended SSL mode: verify-full (or require)
SPRING_DATASOURCE_URL=jdbc:postgresql://<aws-rds-endpoint>:5432/<dbname>?sslmode=verify-full
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<secure-db-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2

# -------------------------------------------------------------------------------
# 5. SECURITY & COOKIE CONFIGURATION
# -------------------------------------------------------------------------------
APP_SECURITY_DEV_AUTH_ENABLED=false
APP_SECURITY_SESSION_COOKIE_SECURE=true
APP_SECURITY_SESSION_COOKIE_NAME=__Host-session
APP_SECURITY_ALLOWED_ORIGINS=https://yourdomain.com

# -------------------------------------------------------------------------------
# 6. OBJECT STORAGE & CDN (Cloudflare R2 S3-Compatible Storage)
# -------------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=S3_COMPATIBLE
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_PRIVATE=interior-platform-media-private
S3_BUCKET_PUBLIC=interior-platform-media-public
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Public CDN / R2 delivery URL for processed derivatives:
PUBLIC_MEDIA_BASE_URL=https://media.yourdomain.com

# -------------------------------------------------------------------------------
# 7. DOCKER IMAGES (GHCR — GitHub Container Registry)
# -------------------------------------------------------------------------------
# Optional: Set when pulling pre-built versioned images from GHCR
# WEB_IMAGE=ghcr.io/<github-owner>/interior-web:latest
# API_IMAGE=ghcr.io/<github-owner>/interior-api:latest

# -------------------------------------------------------------------------------
# 8. EXTERNAL PROVIDERS (UNCONFIGURED AT LAUNCH STEP 3 — PLANNED FOR LATER STEPS)
# -------------------------------------------------------------------------------
# OpenID Connect (OIDC / OAuth2 Google/Apple/Auth0):
# OIDC_ISSUER_URI=https://accounts.google.com
# OIDC_CLIENT_ID=<placeholder_client_id>
# OIDC_CLIENT_SECRET=<placeholder_client_secret>

# AI Visualizer Provider:
# AI_PROVIDER_API_KEY=<placeholder_ai_key>

# WhatsApp Business API:
# WHATSAPP_API_TOKEN=<placeholder_whatsapp_token>
# WHATSAPP_PHONE_NUMBER_ID=<placeholder_phone_id>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<placeholder_verify_token>

# Commercial Payment Gateway (Razorpay / Stripe):
# BILLING_KEY_ID=<placeholder_billing_key>
# BILLING_KEY_SECRET=<placeholder_billing_secret>
# BILLING_WEBHOOK_SECRET=<placeholder_webhook_secret>

# Transactional Email (SendGrid / Postmark / Amazon SES):
# EMAIL_API_KEY=<placeholder_email_key>
# EMAIL_FROM_ADDRESS=notifications@yourdomain.com
