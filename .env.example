# Application Environment Configuration Example
# Copy to .env.local for local development (Do NOT commit actual secret values)

# Database Connection (PostgreSQL 18)
DATABASE_URL=jdbc:postgresql://localhost:5433/interior_design_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# API & Frontend URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000

# Session Configuration
APP_SECURITY_SESSION_COOKIE_NAME=__Host-session

# Identity Provider (Managed OIDC placeholders)
OIDC_ISSUER_URI=https://identity-provider.example.com
OIDC_CLIENT_ID=placeholder_client_id
