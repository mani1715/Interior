# ===============================================================================
# Interior Design Platform — Canonical Environment Variables Template
# DO NOT COMMIT REAL CREDENTIALS. Copy to platform secrets or local env.
# ===============================================================================

# -------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC (Safe, browser-visible configuration)
# -------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://interior.com
NEXT_PUBLIC_API_BASE_URL=https://interior.com/api/v1
# In cross-subdomain setups (Option B), use: NEXT_PUBLIC_API_BASE_URL=https://api.interior.com/api/v1

# -------------------------------------------------------------------------------
# 2. FRONTEND SERVER-ONLY (Node.js runtime environment)
# -------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Optional internal reverse-proxy routing for Option A (e.g. Render private network):
INTERNAL_API_URL=http://interior-api:8080/api/v1

# -------------------------------------------------------------------------------
# 3. BACKEND CORE CONFIGURATION (Spring Boot 3.4 / Java 21)
# -------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework

# -------------------------------------------------------------------------------
# 4. DATABASE CREDENTIALS (Managed PostgreSQL 16+)
# -------------------------------------------------------------------------------
# JDBC URL must include sslmode=require for production managed PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://<managed-postgres-host>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<secure-db-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2

# -------------------------------------------------------------------------------
# 5. SECURITY & COOKIE CONFIGURATION
# -------------------------------------------------------------------------------
APP_SECURITY_DEV_AUTH_ENABLED=false
APP_SECURITY_SESSION_COOKIE_SECURE=true
APP_SECURITY_SESSION_COOKIE_NAME=__Host-session
APP_SECURITY_ALLOWED_ORIGINS=https://interior.com

# -------------------------------------------------------------------------------
# 6. OBJECT STORAGE & CDN (Cloudflare R2 / AWS S3)
# -------------------------------------------------------------------------------
# Local development fallback:
INTERIOR_STORAGE_BASE_PATH=target/storage
INTERIOR_STORAGE_PUBLIC_BASE_URL=/api/v1/media/public

# Production Object Storage (S3-compatible Cloudflare R2 / AWS S3):
# STORAGE_PROVIDER=S3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_PRIVATE=interior-platform-media-private
# S3_BUCKET_PUBLIC=interior-platform-media-public
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# CDN_PUBLIC_BASE_URL=https://media.interior.com

# -------------------------------------------------------------------------------
# 7. EXTERNAL PROVIDERS (UNCONFIGURED AT STEP 1 — CONFIGURE IN LATER LAUNCH STEPS)
# -------------------------------------------------------------------------------
# OpenID Connect (OIDC / OAuth2 Google/Apple/Auth0):
# OIDC_ISSUER_URI=https://accounts.google.com
# OIDC_CLIENT_ID=<placeholder_client_id>
# OIDC_CLIENT_SECRET=<placeholder_client_secret>

# AI Visualizer Provider:
# AI_PROVIDER_API_KEY=<placeholder_ai_key>

# WhatsApp Business API:
# WHATSAPP_API_TOKEN=<placeholder_whatsapp_token>
# WHATSAPP_PHONE_NUMBER_ID=<placeholder_phone_id>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<placeholder_verify_token>

# Commercial Payment Gateway (Razorpay / Stripe):
# BILLING_KEY_ID=<placeholder_billing_key>
# BILLING_KEY_SECRET=<placeholder_billing_secret>
# BILLING_WEBHOOK_SECRET=<placeholder_webhook_secret>

# Transactional Email (SendGrid / Postmark / Amazon SES):
# EMAIL_API_KEY=<placeholder_email_key>
# EMAIL_FROM_ADDRESS=notifications@interior.com
