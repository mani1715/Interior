# ===============================================================================
# Interior Design Platform — Canonical Environment Variables Template
# Production Topology: Hostinger VPS (Docker Compose + Caddy) + AWS RDS PostgreSQL 16 + Cloudflare R2
# DO NOT COMMIT REAL CREDENTIALS. Copy to .env.production on the Hostinger VPS.
# ===============================================================================

# -------------------------------------------------------------------------------
# 1. REVERSE PROXY & DOMAIN ROUTING (Caddy Reverse Proxy on Hostinger VPS)
# -------------------------------------------------------------------------------
APP_DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------------------------
# 2. FRONTEND (Next.js 16 Standalone Container)
# -------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Unified-origin model: relative /api/v1 avoids CORS preflight requests and enables strict __Host- cookies
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Internal Docker networking for server-side Next.js data fetching:
INTERNAL_API_URL=http://api:8080/api/v1

# -------------------------------------------------------------------------------
# 3. BACKEND CORE (Spring Boot 3.4 / Java 21 Container)
# -------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework

# -------------------------------------------------------------------------------
# 4. DATABASE CREDENTIALS (AWS RDS PostgreSQL 16)
# -------------------------------------------------------------------------------
# AWS RDS Endpoint format: <db-name>.<unique-id>.<aws-region>.rds.amazonaws.com
# Recommended SSL mode: verify-full (or require)
SPRING_DATASOURCE_URL=jdbc:postgresql://<aws-rds-endpoint>:5432/<dbname>?sslmode=verify-full
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<secure-db-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2

# -------------------------------------------------------------------------------
# 5. SECURITY & COOKIE CONFIGURATION
# -------------------------------------------------------------------------------
APP_SECURITY_DEV_AUTH_ENABLED=false
APP_SECURITY_SESSION_COOKIE_SECURE=true
APP_SECURITY_SESSION_COOKIE_NAME=__Host-session
APP_SECURITY_ALLOWED_ORIGINS=https://yourdomain.com
# MFA Secret Encryption Master Key (32-byte AES-256-GCM key)
APP_SECURITY_MFA_ENCRYPTION_KEY=<REPLACE_ME_32_BYTE_MFA_MASTER_KEY>

# -------------------------------------------------------------------------------
# 6. OBJECT STORAGE & CDN (Cloudflare R2 S3-Compatible Storage)
# -------------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=S3_COMPATIBLE
S3_ENDPOINT=https://<REPLACE_ME_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_PRIVATE=<REPLACE_ME_PRIVATE_MEDIA_BUCKET>
S3_BUCKET_PUBLIC=<REPLACE_ME_PUBLIC_MEDIA_BUCKET>
S3_ACCESS_KEY_ID=<REPLACE_ME_R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<REPLACE_ME_R2_SECRET_ACCESS_KEY>
# Public CDN / R2 delivery URL for processed derivatives:
PUBLIC_MEDIA_BASE_URL=https://<REPLACE_ME_MEDIA_DOMAIN>

# -------------------------------------------------------------------------------
# 7. UPLOAD SECURITY & MALWARE SCANNING (ClamAV TCP Streaming Daemon)
# -------------------------------------------------------------------------------
MALWARE_SCANNER_PROVIDER=clamav
REQUIRE_CLEAN_SCAN=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=3000
CLAMAV_READ_TIMEOUT_MS=10000

# -------------------------------------------------------------------------------
# 8. DOCKER IMAGES (GHCR — GitHub Container Registry)
# -------------------------------------------------------------------------------
# Optional: Set when pulling pre-built versioned images from GHCR
# WEB_IMAGE=ghcr.io/<github-owner>/interior-web:latest
# API_IMAGE=ghcr.io/<github-owner>/interior-api:latest

# -------------------------------------------------------------------------------
# 9. EXTERNAL PROVIDERS (UNCONFIGURED AT CURRENT PHASE — PLANNED FOR PHASE 15)
# -------------------------------------------------------------------------------
# OpenID Connect (Target: Google OIDC — Live Activation Deferred to Phase 15):
# GOOGLE_OIDC_ISSUER=https://accounts.google.com
# GOOGLE_CLIENT_ID=<placeholder_google_client_id>
# GOOGLE_CLIENT_SECRET=<placeholder_google_client_secret>
# GOOGLE_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/callback

# AI Visualizer & Interior Generation (Target: Google Vertex / Stability / Replicate — Live Activation Deferred to Phase 15):
# AI_VISUALIZER_ENABLED=true
# AI_PROVIDER=none
# AI_API_KEY=<REPLACE_ME_AI_API_KEY>
# AI_ENDPOINT=https://api.stability.ai/v2beta/stable-image/generate/core
# AI_MODEL=interior-diffusion-v1
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=2
# AI_DAILY_STUDIO_LIMIT=20
# AI_GLOBAL_DAILY_BUDGET_MINOR=0
# AI_DEFAULT_STUDIO_MONTHLY_BUDGET_MINOR=0

# WhatsApp Business API:
# WHATSAPP_API_TOKEN=<placeholder_whatsapp_token>
# WHATSAPP_PHONE_NUMBER_ID=<placeholder_phone_id>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<placeholder_verify_token>

# Commercial Payment Gateway (Razorpay / Stripe):
# BILLING_KEY_ID=<placeholder_billing_key>
# BILLING_KEY_SECRET=<placeholder_billing_secret>
# BILLING_WEBHOOK_SECRET=<placeholder_webhook_secret>

# Transactional Email (Target: Resend / AWS SES — Live Activation Deferred to Phase 15):
# EMAIL_PROVIDER=disabled
# EMAIL_FROM_ADDRESS=<EMAIL_FROM_ADDRESS>
# EMAIL_FROM_NAME=Elégance
# EMAIL_REPLY_TO=
# EMAIL_MAX_RETRIES=3
# EMAIL_BASE_RETRY_DELAY_SECONDS=60
# EMAIL_TIMEOUT_SECONDS=15
# EMAIL_WEBHOOK_SECRET=<REPLACE_ME_WEBHOOK_SECRET>
# If using Resend:
# RESEND_API_KEY=<REPLACE_ME_RESEND_API_KEY>
# RESEND_API_URL=https://api.resend.com/emails
# If using AWS SES:
# AWS_SES_REGION=us-east-1
# AWS_SES_CONFIGURATION_SET=
# AWS_SES_ACCESS_KEY_ID=<REPLACE_ME_AWS_ACCESS_KEY_ID>
# AWS_SES_SECRET_ACCESS_KEY=<REPLACE_ME_AWS_SECRET_ACCESS_KEY>
# AWS_SES_ENDPOINT=
